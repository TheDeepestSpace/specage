{
  "name": "specage",
  "build": { "dockerfile": "../Dockerfile", "target": "dev", "context": ".." },
  "remoteUser": "dev",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173, 8080],
  "portsAttributes": { "5173": { "label": "Vite" }, "8080": { "label": "specage server" } },
  "containerEnv": { "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright" }
}
